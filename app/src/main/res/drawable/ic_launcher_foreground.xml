<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec 017 — adaptive icon foreground. Replaces the project-template robot (FR-001).

  Carries the mark's DISC AND NUMERALS, on the flat brand field supplied by
  ic_launcher_background.xml. Derived from the same approved source as
  ic_brand_mark.xml (INV-1); the geometry below is identical, only scaled.

  Sizing: an adaptive-icon layer is 108dp, of which only the centre 72dp is guaranteed
  visible under every device mask — circle, squircle, rounded square or teardrop. The
  viewport is kept at 432 so the path data matches the splash mark exactly, and the
  group scale of 0.985 lands the Ø268 disc at Ø66dp inside that 72dp safe zone, leaving
  3dp of clearance on each side (FR-005, SC-009).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">

    <group
        android:pivotX="216"
        android:pivotY="216"
        android:scaleX="0.985"
        android:scaleY="0.985">

        <path android:pathData="M216,82a134,134 0 1,0 0,268a134,134 0 1,0 0,-268z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="122"
                    android:startY="122"
                    android:endX="310"
                    android:endY="310"
                    android:type="linear">
                    <item android:color="@color/brand_mark_primary" android:offset="0" />
                    <item android:color="@color/brand_mark_accent" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="@color/brand_mark_on_surface"
            android:pathData="M150,194c0,-13 11,-23 30,-23c19,0 30,10 30,24c0,9 -5,16 -13,19c9,3 15,11 15,21c0,16 -13,27 -32,27c-19,0 -32,-10 -33,-25l17,0c1,6 7,10 16,10c9,0 15,-5 15,-12c0,-8 -6,-12 -16,-12l-8,0l0,-14l8,0c9,0 14,-4 14,-11c0,-7 -5,-11 -13,-11c-8,0 -13,4 -14,10z" />
        <path
            android:fillColor="@color/brand_mark_on_surface"
            android:pathData="M252,171c18,0 30,9 32,24l-17,0c-2,-6 -7,-10 -15,-10c-12,0 -19,9 -19,26l0,3c4,-8 13,-13 24,-13c17,0 30,12 30,30c0,18 -14,31 -34,31c-23,0 -37,-15 -37,-43l0,-8c0,-26 14,-40 36,-40zM251,227c-9,0 -16,7 -16,16c0,9 7,16 16,16c10,0 16,-6 16,-16c0,-9 -6,-16 -16,-16z" />
