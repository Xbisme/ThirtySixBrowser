<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec 017 — ThirtySix brand mark (static).

  Derived from specs/017-splash-screen/assets/brand-mark-approved.svg, approved by the
  product owner 2026-09-15. That file is the single source for this drawable, the
  animated variant in drawable-v31/, the monochrome variant, and the density bitmaps
  (INV-1) — do not edit this file in isolation.

  Geometry: a 432-unit viewport matching the launch-screen icon frame, so the path data
  is in frame coordinates. The visible area is the centred 288-unit circle, so all art
  stays inside r=144 from centre; the disc is r=134, leaving 10 units of clearance
  (INV-3, research.md R5). The intrinsic width/height are declared at 108dp only to stay
  under lint's VectorRaster 200dp ceiling — the splash theme and the adaptive icon both
  scale this to their own frame, so the declared size is never what is drawn.

  The numerals are drawn as filled outline paths, not text: VectorDrawable cannot render
  <text> (A9, R8). They are FILLED SOLID and must never be cut out of the disc — a
  cut-out takes its colour from whatever is behind it and turned the numerals near-black
  on a dark background, which is why that version was rejected (FR-003, INV-4).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">

    <!-- Disc: r=134 centred at (216,216), brand gradient. -->
    <path android:pathData="M216,82a134,134 0 1,0 0,268a134,134 0 1,0 0,-268z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="122"
                android:startY="122"
                android:endX="310"
                android:endY="310"
                android:type="linear">
                <item android:color="@color/brand_mark_primary" android:offset="0" />
                <item android:color="@color/brand_mark_accent" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Numeral "3" — centre x≈180, cap height 96 (y 168..264). -->
    <path
        android:fillColor="@color/brand_mark_on_surface"
        android:pathData="M150,194c0,-13 11,-23 30,-23c19,0 30,10 30,24c0,9 -5,16 -13,19c9,3 15,11 15,21c0,16 -13,27 -32,27c-19,0 -32,-10 -33,-25l17,0c1,6 7,10 16,10c9,0 15,-5 15,-12c0,-8 -6,-12 -16,-12l-8,0l0,-14l8,0c9,0 14,-4 14,-11c0,-7 -5,-11 -13,-11c-8,0 -13,4 -14,10z" />

    <!-- Numeral "6" — centre x≈252, same cap height. -->
    <path
        android:fillColor="@color/brand_mark_on_surface"
        android:pathData="M252,171c18,0 30,9 32,24l-17,0c-2,-6 -7,-10 -15,-10c-12,0 -19,9 -19,26l0,3c4,-8 13,-13 24,-13c17,0 30,12 30,30c0,18 -14,31 -34,31c-23,0 -37,-15 -37,-43l0,-8c0,-26 14,-40 36,-40zM251,227c-9,0 -16,7 -16,16c0,9 7,16 16,16c10,0 16,-6 16,-16c0,-9 -6,-16 -16,-16z" />
</vector>
