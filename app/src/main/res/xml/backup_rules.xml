<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup, Android 11 and lower. The database (bookmarks, history, tabs) and its WAL files
   stay on the device. Settings are backed up through the default; adding any <include> would
   switch to exclude-by-default.
-->
<full-backup-content>
    <exclude domain="database" path="thirtysix_browser.db"/>
    <exclude domain="database" path="thirtysix_browser.db-wal"/>
    <exclude domain="database" path="thirtysix_browser.db-shm"/>
</full-backup-content>
