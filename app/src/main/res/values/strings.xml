<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">ThirtySix Browser</string>
    <!-- Spec 002 — placeholder labels for the 7 navigation destinations. -->
    <!-- Spec 004 — VI/DE/RU/KO/JA/ZH/FR translations live in values-<locale>/. -->
    <!-- Spec 004 — Q1 clarification: app_name canonical = "ThirtySix Browser" (Play Store name). -->
    <!-- Per FR-007 naming convention: feature_section_purpose. -->
    <!-- Future feature specs (e.g., 011 tabs-management) MAY rename *_screen_placeholder → semantic key (*_screen_title) when they implement the real Screen — must update all 8 locale files in same change. -->

    <string name="bookmarks_screen_placeholder">Bookmarks</string>
    <string name="history_screen_placeholder">History</string>
    <string name="downloads_screen_placeholder">Downloads</string>
    <string name="settings_screen_placeholder">Settings</string>
    <string name="onboarding_screen_placeholder">Onboarding</string>

    <!-- Spec 007 — WebView Compose Wrapper. Loading state + error UI strings. -->
    <string name="browser_loading_a11y">Loading page</string>
    <string name="browser_error_title">Page didn\'t load</string>
    <string name="browser_error_offline_hint">Check your internet connection and try again.</string>
    <string name="browser_error_generic">Something went wrong. Try opening the page later.</string>

    <!-- Spec 008 — Navigation Controls. Bottom-bar affordance content descriptions (a11y / TalkBack). -->
    <string name="browser_action_back">Back</string>
    <string name="browser_action_forward">Forward</string>
    <string name="browser_action_reload">Reload page</string>
    <string name="browser_action_stop">Stop loading</string>
    <string name="browser_action_home">Home</string>

    <!-- Spec 009 — Address Bar / Omnibox. Placeholder hint shown when the bar is unfocused with no URL loaded; clear-button content description (TalkBack). -->
    <string name="browser_address_bar_hint">Search or enter URL</string>
    <string name="browser_address_bar_clear_cd">Clear address bar</string>

    <!-- Spec 011 — Tabs Management. Switcher screen + tab card + BrowserScreen new affordances + plural-aware count. -->
    <string name="tabs_switcher_new_tab">New tab</string>
    <string name="tabs_switcher_close_all">Close all tabs</string>
    <string name="tabs_switcher_close_all_confirm">Close all tabs? This cannot be undone.</string>
    <string name="tabs_card_close">Close tab</string>
    <string name="tabs_default_title">New tab</string>
    <string name="browser_action_tabs_switcher">Open tabs switcher</string>
    <string name="browser_action_new_tab">Open new tab</string>
    <string name="browser_max_tabs_reached">Maximum number of tabs reached. Close a tab to open a new one.</string>

    <plurals name="tabs_switcher_title_count">
        <item quantity="one">%1$d tab</item>
        <item quantity="other">%1$d tabs</item>
    </plurals>

    <!-- Spec 012 — Private / Incognito Mode. New strings: incognito affordances, indicator, dialog, errors, a11y. -->
    <string name="tabs_action_new_incognito_tab">New incognito tab</string>
    <string name="tabs_a11y_new_incognito_tab">Open new incognito tab</string>
    <string name="tabs_a11y_incognito_glyph">Incognito tab</string>
    <!-- Spec 012 — cap is MAX_INCOGNITO_TABS = 50 (always > 1), so the singular case is unreachable. Plural form intentionally omitted. -->
    <string name="tabs_error_max_incognito_tabs_reached" tools:ignore="PluralsCandidate">You\'ve reached the maximum of %d incognito tabs</string>
    <string name="browser_a11y_incognito_indicator">Incognito mode active</string>
    <string name="tabs_a11y_incognito_card_placeholder">Incognito tab — content hidden for privacy</string>
    <string name="tabs_card_incognito_label">Incognito</string>
    <string name="tabs_action_close_all_incognito">Close all incognito</string>
    <!-- Spec 012 — affordance only visible when count > 0; in practice users see this dialog with count ≥ 1, plural form is the rule. tools:ignore acknowledged in lint per project policy. -->
    <string name="tabs_close_all_incognito_confirm" tools:ignore="PluralsCandidate">Close all %d incognito tabs?</string>
</resources>
