<?xml version="1.0" encoding="utf-8"?>
<!--
  Only colors that XML must resolve before Compose runs: the cold-start window backgrounds
  and the brand mark used by the launcher icon and launch screen. They mirror the theme in
  Kotlin; nothing in Compose may read them, and every UI color belongs in the theme.
-->
<resources>
    <color name="window_background_light">#FFFFFF</color>
    <color name="window_background_dark">#0E0D12</color>

    <!-- brand mark. -->
    <color name="brand_mark_primary">#6C4CF1</color>
    <color name="brand_mark_accent">#8F6FFF</color>
    <color name="brand_mark_on_surface">#FAFAF9</color>
</resources>
