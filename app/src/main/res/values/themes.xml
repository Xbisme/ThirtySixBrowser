<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MainActivity is an AppCompatActivity (needed for in-app language
         switching below Android 13), and AppCompat refuses to start without an AppCompat theme.
         The two items are 's cold-start fix and are unchanged. -->
    <style name="Theme.ThirtySix" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch-screen theme. The parent must not be AppCompat: Theme.SplashScreen builds on
         DeviceDefault. AppCompat works because installSplashScreen(), called before
         super.onCreate(), applies postSplashScreenTheme; without that the app crashes at launch. -->
    <style name="Theme.ThirtySix.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.ThirtySix</item>
        <item name="windowSplashScreenBackground">@color/window_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
        <!-- Metadata only: it does not lengthen the splash screen, which ends at the first
             drawable frame. Must be > 0 for an animated icon. -->
        <item name="windowSplashScreenAnimationDuration">@integer/splash_icon_animation_duration</item>
    </style>
</resources>
