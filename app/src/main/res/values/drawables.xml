<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Below API 31 ic_brand_mark aliases the static mark; on 31+ the animated one in drawable-v31
      wins. Compose UI must use ic_brand_mark_static: painterResource crashes on an animated-vector.
    -->
    <drawable name="ic_brand_mark">@drawable/ic_brand_mark_static</drawable>
</resources>
