<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Spec 007 — WebView page load. Constitution v1.3.0 §II names these two as the app's
         minimum permission set. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Spec 015 FR-009 – FR-013 — writing to the device's PUBLIC Downloads folder needed
         this permission before Scoped Storage arrived in API 29, and this project's
         minSdk is 24. The maxSdkVersion ceiling means it is absent from the effective
         manifest on API 29+, so modern users never see it in the Play listing and it can
         never be requested there; on API 24-28 it is requested at the moment of the first
         download, never at launch.

         This is the single documented deviation in Constitution v1.3.0 §II's permission table,
         recorded in specs/015-downloads-manager/plan.md "Complexity Tracking".
         MANAGE_EXTERNAL_STORAGE remains forbidden (FR-013) and is NOT declared.

         POST_NOTIFICATIONS is deliberately NOT declared and MUST NOT be: Spec 015 gate G9
         (Outcome A) confirmed on device that the system download service posts its
         notifications under its own identity, so this app never needs the permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Spec 021 FR-001 / FR-002 / FR-037 — a site's camera, microphone or location request.
         Each is requested only after the person chose an allow option for that site (or chose
         to take a photo for a file upload), never at launch. Listed in the Constitution's
         permission table. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Spec 021 — WebView's audio capture (WebRTC) requires this alongside RECORD_AUDIO
         (PermissionRequest.RESOURCE_AUDIO_CAPTURE). A normal permission: granted at install,
         never prompted. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Spec 021 research R10 — none of these is needed to install or use the browser. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".ThirtySixApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThirtySix"
        tools:targetApi="33">
        <!-- Spec 017 — the activity starts on the splash theme; installSplashScreen()
             swaps in Theme.ThirtySix (its postSplashScreenTheme) before AppCompat builds
             its delegate. The <application> theme above stays Theme.ThirtySix. -->
        <!-- Spec 019 — the activity handles a language change itself (locale|layoutDirection), so
             applying a language no longer recreates it: no black frames, no WebView rebuild.
             AppCompat delivers onConfigurationChanged on every API level once the activity
             declares these; Compose re-reads strings through LocalConfiguration.
             screenLayout is needed too: the FIRST change away from "follow system" also reports
             CONFIG_SCREEN_LAYOUT (seen on a Galaxy A55, Android 16), and leaving it out
             recreated the activity on exactly that first choice. -->
        <!-- Spec 020 research R2 — singleTask: one instance in ThirtySix's own task. With the default
             launch mode every link from another app would start a second MainActivity inside the
             sender's task (one recents entry and one WebView per link, FR-004). New links arrive
             in onNewIntent; Back on an untouched external tab uses moveTaskToBack to return to the
             sender (FR-006). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ThirtySix.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Spec 020 FR-001 — marks the app as a browser for launchers and the system. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.APP_BROWSER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Spec 020 FR-001 / FR-002 — web links ONLY: http and https, any host. This is the
                 filter that puts the app in "Open with" and makes it eligible for the browser
                 role. No other scheme may ever be added here (contracts C1-1). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- Spec 020 FR-009 — plain text from another app's Share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Spec 020 FR-011 — "Search with ThirtySix" in other apps' text-selection menu. -->
            <intent-filter android:label="@string/entry_process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Spec 020 FR-012 — the system's web-search request. -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Spec 016 research R1 — lets AndroidX persist the in-app language on Android 7.0–12.
             With autoStoreLocales, AppCompat saves the user's choice and re-applies it at start-up;
             on Android 13+ the framework stores it instead. Disabled and not exported: the service
             is never started, it only carries this metadata. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>