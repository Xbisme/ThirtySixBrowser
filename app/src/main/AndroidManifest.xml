<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Spec 007 — WebView page load. Constitution §II "Permission table" assigns
         these two to Spec 007. POST_NOTIFICATIONS was reserved for Spec 015; see the note below. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Spec 015 FR-009 – FR-013 — writing to the device's PUBLIC Downloads folder needed
         this permission before Scoped Storage arrived in API 29, and this project's
         minSdk is 24. The maxSdkVersion ceiling means it is absent from the effective
         manifest on API 29+, so modern users never see it in the Play listing and it can
         never be requested there; on API 24-28 it is requested at the moment of the first
         download, never at launch.

         This is the FOURTH permission, against the Constitution's three-row table — a
         deliberate, documented deviation recorded in
         specs/015-downloads-manager/plan.md "Complexity Tracking". MANAGE_EXTERNAL_STORAGE
         remains forbidden (FR-013) and is NOT declared.

         POST_NOTIFICATIONS is deliberately still absent: gate G9 must determine on a device
         whether the system download service's own notifications require it (FR-048). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ThirtySixApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThirtySix"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ThirtySix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>