<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The minimum set: loading pages. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Writing to the public Downloads folder needs this before Scoped Storage (API 29); the
         ceiling keeps it out of the effective manifest from API 29 on. Asked at the first download.
         POST_NOTIFICATIONS is deliberately absent: the system download service notifies under its
         own identity. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- A site's camera, microphone or location request; asked only after the person allows the
         site (or takes a photo for an upload), never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- WebView audio capture (WebRTC) needs this alongside RECORD_AUDIO. Normal permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- None of these is needed to install or use the browser. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".ThirtySixApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ThirtySix"
        tools:targetApi="33">
        <!-- usesCleartextTraffic: a browser has to open http:// sites. Mixed content stays blocked. -->
        <!-- Starts on the splash theme; installSplashScreen() swaps in Theme.ThirtySix before
             AppCompat builds its delegate. -->
        <!-- Language, rotation and size changes are handled in place, so the WebView is not rebuilt.
             screenLayout is needed too: the first change away from "follow system" also reports
             CONFIG_SCREEN_LAYOUT (seen on Android 16). -->
        <!-- singleTask: otherwise each link from another app starts a MainActivity in the sender's
             task. New links arrive in onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection|screenLayout|orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ThirtySix.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Marks the app as a browser for launchers and the system. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.APP_BROWSER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Web links only, http and https, any host: this filter puts the app in "Open with" and
                 makes it eligible for the browser role. Never add another scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- Plain text from another app's Share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- "Search with ThirtySix" in other apps' text-selection menu. -->
            <intent-filter android:label="@string/entry_process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- The system's web-search request. -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Gives the camera app a place to write a photo for a page's file upload. Only
             cache/capture/ is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Lets AppCompat store and re-apply the in-app language below Android 13. Disabled: the
             service only carries this metadata. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>