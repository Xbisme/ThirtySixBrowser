<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Spec 007 — register HiltTestActivity in the DEBUG variant only.
        Lives in app/src/debug/ (not androidTest/) so the activity is bundled
        into the debug APK's process (`com.raumanian.thirtysix.browser.debug`)
        and instrumentation can launch it without the cross-process intent
        mismatch that occurs when an Activity is declared inside the test APK.
        See https://developer.android.com/training/dependency-injection/hilt-testing.
    -->
    <application>
        <activity
            android:name="com.raumanian.thirtysix.browser.HiltTestActivity"
            android:exported="false"
            tools:ignore="MissingClass" />

        <!--
            Spec 014 T103a — debug-only bulk history seeder for the SC-005 / SC-006
            benchmark (quickstart gate G8). Declared here so it ships in the debug APK
            only; the release variant never compiles `app/src/debug/`. `exported="true"`
            is required for `adb shell am broadcast` to reach it from the shell uid, and
            is safe because the receiver exists solely in debug builds.
        -->
        <receiver
            android:name="com.raumanian.thirtysix.browser.dev.HistorySeeder"
            android:exported="true"
            tools:ignore="MissingClass,ExportedReceiver">
            <intent-filter>
                <action android:name="com.raumanian.thirtysix.browser.debug.SEED_HISTORY" />
                <action android:name="com.raumanian.thirtysix.browser.debug.CLEAR_HISTORY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
