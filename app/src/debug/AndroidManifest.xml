<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        HiltTestActivity lives in the debug APK, not the test APK, so instrumentation can launch it
        in the app process without a cross-process intent mismatch.
    -->
    <application>
        <activity
            android:name="com.raumanian.thirtysix.browser.HiltTestActivity"
            android:exported="false"
            tools:ignore="MissingClass" />

        <!--
            Debug-only seeders and hooks. Exported so `adb shell am broadcast` can reach them from
            the shell uid; safe because the debug source set never ships in a release build.
        -->
        <receiver
            android:name="com.raumanian.thirtysix.browser.dev.HistorySeeder"
            android:exported="true"
            tools:ignore="MissingClass,ExportedReceiver">
            <intent-filter>
                <action android:name="com.raumanian.thirtysix.browser.debug.SEED_HISTORY" />
                <action android:name="com.raumanian.thirtysix.browser.debug.CLEAR_HISTORY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.raumanian.thirtysix.browser.dev.DownloadSeeder"
            android:exported="true"
            tools:ignore="MissingClass,ExportedReceiver">
            <intent-filter>
                <action android:name="com.raumanian.thirtysix.browser.debug.SEED_DOWNLOADS" />
                <action android:name="com.raumanian.thirtysix.browser.debug.CLEAR_DOWNLOADS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.raumanian.thirtysix.browser.dev.TabSeeder"
            android:exported="true"
            tools:ignore="MissingClass,ExportedReceiver">
            <intent-filter>
                <action android:name="com.raumanian.thirtysix.browser.debug.SEED_TABS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.raumanian.thirtysix.browser.dev.FireStepDelayReceiver"
            android:exported="true"
            tools:ignore="MissingClass,ExportedReceiver">
            <intent-filter>
                <action android:name="com.raumanian.thirtysix.browser.debug.FIRE_STEP_DELAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
